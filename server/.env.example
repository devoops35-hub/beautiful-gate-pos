# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=3003

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beautiful_gate_pos
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# ==========================================
# JWT Authentication
# ==========================================
# IMPORTANT: Generate a strong secret using:
# openssl rand -base64 32
# Must be at least 16 characters long
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# ==========================================
# Paystack Payment Gateway
# ==========================================
# Get from: https://dashboard.paystack.com
# For development, use Test keys (sk_test_, pk_test_)
# For production, use Live keys (sk_live_, pk_live_)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# ==========================================
# CORS Configuration
# ==========================================
# List of allowed origins separated by commas
# No spaces around commas
# IMPORTANT: In production, NEVER use * (wildcard)
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
